# Copy this file to .env and fill in the values below.
# These are safe to bundle into the app; access is controlled by Firestore
# rules (Firebase) and the upload preset (Cloudinary).

# Firebase project settings → General → Your apps → SDK setup and configuration
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Cloudinary dashboard (cloud name) + an unsigned upload preset you create
EXPO_PUBLIC_CLOUDINARY_CLOUD_NAME=
EXPO_PUBLIC_CLOUDINARY_UPLOAD_PRESET=
